NODE_ENV=development
PORT=3000
# Exact origin, no trailing slash. HTTPS is required in production.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://autopost:CHANGE_ME@localhost:5432/autopost
# require for production managed PostgreSQL; never disable certificate verification.
DATABASE_SSL=disable
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable and backed up securely; changing it makes existing credentials unreadable.
DATA_ENCRYPTION_KEY=
DATA_ROOT=./data
# Use a local SMTP catcher for development. Real delivery is required for account verification.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=AutoPost <noreply@example.com>
# Explicit trusted proxy IPs/CIDRs only. Leave empty without a reverse proxy.
TRUST_PROXY=
# Background integrations are opt-in until staging tests pass.
ENABLE_AUTOMATION=false
ENABLE_WEBHOOKS=false
FB_APP_SECRET=
FB_VERIFY_TOKEN=
# Customer Facebook/Gemini credentials are entered in authenticated settings, not global env.
# No canned/secondary text fallback is used after Gemini failure.
# Image generation may use topic-matched external providers; review provider terms.
# Security cap on stored media per workspace (256 MiB by default).
MAX_WORKSPACE_MEDIA_BYTES=268435456

# PostgreSQL pool and timeout policy (milliseconds).
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
# Optional trusted PostgreSQL CA certificate file. TLS verification is never disabled.
DATABASE_CA_FILE=
# DATABASE_URL must not contain sslmode/sslcert parameters; use DATABASE_SSL/CA_FILE.
