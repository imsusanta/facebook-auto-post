# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Access Control
# Required in production: generate a 64-char hex key (e.g. via `openssl rand -hex 32`)
ADMIN_API_KEY=
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Allow development bypass when ADMIN_API_KEY is not set (defaults to false in production)
DEV_AUTH_BYPASS=false

# Facebook Graph API Credentials
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=your_custom_webhook_verify_token

# Google Gemini AI API
GEMINI_API_KEY=

# Testing / Simulation Mode (set to true to test without calling Facebook API)
SIMULATION_MODE=false
