    "express": "^5.1.0",
    "form-data": "^4.0.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide": "^0.468.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.17"
