{
  "name": "facebook-auto-poster",
  "version": "1.0.0",
  "description": "Facebook Auto-Poster & Live Monitoring Dashboard UI",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:encoding": "node scripts/check-encoding.js",
    "lint": "eslint .",
    "test": "node tests/runner.js",
    "test:postgres": "node tests/postgres-runner.js",
    "test:safety-guard": "node tests/safety-guard.test.js",
    "test:browser:customer": "node tests/browser-customer-ui.test.js",
    "verify:clean": "bash scripts/verify-clean-worktree.sh",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "db:rollback": "node scripts/migrate.js --rollback"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "playwright": "^1.63.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
