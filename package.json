{
  "name": "facebook-auto-poster",
  "version": "1.0.0",
  "description": "Facebook Auto-Poster & Live Monitoring Dashboard UI",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
